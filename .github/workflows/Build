name: 手动Build

on:
  workflow_dispatch:

permissions:
  contents: read
  packages: write

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      # =========================
      # 1. 拉代码
      # =========================
      - name: Checkout
        uses: actions/checkout@v5

      # =========================
      # 2. repo 名
      # =========================
      - name: Repo name
        id: repo
        run: |
          echo "repo=$(echo '${{ github.repository }}' | tr '[:upper:]' '[:lower:]')" >> $GITHUB_OUTPUT

      # =========================
      # 3. QEMU（支持 ARM）
      # =========================
      - name: Set up QEMU
        uses: docker/setup-qemu-action@v3

      # =========================
      # 4. Buildx
      # =========================
      - name: Set up Buildx
        uses: docker/setup-buildx-action@v3

      # =========================
      # 5. 登录 GHCR
      # =========================
      - name: Login GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      # =========================
      # 6. 生成版本（手动构建标记）
      # =========================
      - name: Version
        id: ver
        run: |
          VERSION=manual-$(date +'%Y%m%d-%H%M%S')
          echo "version=$VERSION" >> $GITHUB_OUTPUT

      # =========================
      # 7. Build & Push Docker
      # =========================
      - name: Build and Push
        uses: docker/build-push-action@v7
        with:
          context: ./src
          file: ./src/Dockerfile
          push: true
          platforms: linux/amd64,linux/arm64
          tags: |
            ghcr.io/${{ steps.repo.outputs.repo }}:manual
            ghcr.io/${{ steps.repo.outputs.repo }}:${{ steps.ver.outputs.version }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
